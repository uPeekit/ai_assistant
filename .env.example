# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# Claude: every model the bot asks, except a local mail model below. Without a key the vault,
# web research and link answers stay off.
# An API key from platform.claude.com, not a claude.ai subscription (see README).
ANTHROPIC_API_KEY=
# Answers a question about a linked page.
CLAUDE_MODEL=claude-haiku-4-5
# The second opinion on a vault answer it could not settle, and on a watched folder's summary.
# Empty = never asked.
ESCALATE_MODEL=claude-sonnet-5
# Web research ("найди ... и запиши в ...") — needs the key above. Sonnet writes the better
# note; claude-haiku-4-5 costs about a third as much if a search feels too expensive.
RESEARCH_MODEL=claude-sonnet-5
RESEARCH_MAX_SEARCHES=4
# Site searches and page reads per lookup, and the seconds after which the tools are switched
# off and the model answers with what it found. RESEARCH_DEADLINE_S is only a backstop.
RESEARCH_MAX_READS=8
RESEARCH_SOFT_DEADLINE_S=90
RESEARCH_DEADLINE_S=180
# Optional: pages are read through Jina Reader (r.jina.ai), free without a key at ~20 pages a
# minute. It sees which public pages are read, not your messages.
JINA_API_KEY=
# A group with the "media" right answers an Instagram link with the post's video or photos.
# When Instagram refuses, these mirrors are tried in order: "{id}" is the post's code, "{n}"
# the item of a carousel from 0. Drop one that died, add a new one; no release needed.
INSTAGRAM_MIRRORS=https://vxinstagram.com/offload/{id}/{n},https://kkinstagram.com/p/{id}/
# Rewriting text you already wrote ("перепиши заметку, оставь один подход"). Sonnet: this
# is your own writing being consolidated, and a cheaper model loses facts while shortening.
REWRITE_MODEL=claude-sonnet-5
# A joke for a group with the "banter" right that calls the bot for nothing. Empty = stock lines.
BANTER_MODEL=claude-sonnet-5

# What to call the bot, with any other spellings you use, separated by commas. The name is
# taken off the start or the end of a message before anything reads it; anywhere else in a
# sentence it is just a word. Empty = the bot has no name.
BOT_NAME=

# Obsidian: where the bot writes (documentation/ARCHITECTURE.md). A vault is a folder of markdown
# files on this machine; no plugin is needed, and Obsidian does not have to be running. Empty = off.
OBSIDIAN_VAULT=
# Syncthing's config.xml, for the sync health check. Empty: the Windows default,
# %LOCALAPPDATA%\Syncthing\config.xml. Without a readable one, Syncthing is not watched.
SYNCTHING_CONFIG=
OBSIDIAN_ENABLED=true
# When the bot sends the morning agenda from the vault (HH:MM in TIMEZONE). Empty = never.
DAILY_DIGEST_AT=09:00
# The vault's own interpreter, and the pass that links a new note to existing ones.
FILER_MODEL=claude-haiku-4-5
# single = one question about everything; staged = intent, then target, then details.
FILER_MODE=staged
# Asked the same question when the filer's answer is visibly off (an empty note, an inbox
# line). Empty turns the second reading off; set FILER_MODEL to this one to always use it.
FILER_STRONG_MODEL=claude-sonnet-5
LINKER_MODEL=claude-haiku-4-5
LINKER_ENABLED=true
# Answers a question about the vault from the notes its search found. Empty: the reply is
# the list of notes found.
VAULT_ANSWER_MODEL=claude-haiku-4-5
# Obsidian's Omnisearch plugin over its local HTTP server (switch "HTTP server" on in its
# settings); used while Obsidian runs, skipped when it does not. 0: never asked.
OMNISEARCH_PORT=51361

# Mail: a read-only digest of what arrived, sorted into buckets. Gmail over IMAP with an app
# password (myaccount.google.com/apppasswords, needs 2-Step Verification) — no OAuth, no token
# that expires weekly. The bot only reads: there is no code path that marks, deletes or sends.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_DIGEST_AT=12:00,19:00
# Buckets are edited on the admin page (data/mail_buckets.txt) and re-read on every run, so a
# change needs no restart. This is only the starting point if that file does not exist yet:
# "name: what belongs in it", comma-separated — a description may itself contain commas, since
# a new bucket starts only where a "name:" follows one. Empty = the built-in list.
MAIL_BUCKETS=
# Who sorts the mail: a claude-... model through the API (needs ANTHROPIC_API_KEY), or any
# other name as a local Ollama model, which needs no key. qwen3:8b matched Haiku closely over
# a week of side-by-side digests. Ollama must be running at digest time.
MAIL_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
# The context window a local mail model gets. A request that overflows it is split and retried.
LLM_NUM_CTX=8192
# A trial, off by default: Ollama models, comma-separated (e.g. qwen3:8b,gemma3:1b), that each
# sort the same mail again. Each sends its own digest after the real one, in this order, so they
# can be read side by side. They never touch the real digest — a model that is not running only
# changes its own message. They run one at a time and each is unloaded as soon as it is done.
MAIL_SHADOW_MODEL=
MAIL_SHADOW_BATCH=20

# Speech
WHISPER_MODEL=large-v3-turbo
# cpu, not auto: a local mail model leaves little VRAM for Whisper on an 8 GB card.
# With no local model, or on a bigger GPU, set this back to auto.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Locale
# Your own IANA time zone (e.g. Europe/Paris, America/New_York): dates in messages, the morning
# agenda, the mail digest and reminders all run on it.
TIMEZONE=UTC
LOCALE=ru

# Storage
DB_PATH=data/bot.sqlite
ADMIN_UI_PORT=8787

UNDO_WINDOW_S=300
LOG_LEVEL=INFO
# Rotating log file (5 MB x 5), redacted like the console. Empty = console only.
LOG_FILE=logs/bot.log
